# Copy to .env and fill in. .env is git-ignored and its values are never logged.

# Contact address sent in the User-Agent and as the NCBI `email` parameter, so that a
# provider can reach you before blocking you. Required for any live fetch.
CONTACT_EMAIL=

# Free key from NCBI account settings. Optional: raises the E-utilities limit from
# about 3 to about 10 requests per second.
NCBI_API_KEY=

# Value of the NCBI `tool` parameter.
NCBI_TOOL=synergyrx-data
