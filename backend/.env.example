# Copy to backend/.env to override a default. Nothing here is required for local development.

# Accounts created the first time the API starts on an empty database.
# Changing these later has no effect: use the admin page instead.
TUJYA_ADMIN_EMAIL=admin@gmail.com
TUJYA_ADMIN_PASSWORD=admin
TUJYA_SEED_DEMO_USER=true

# Set to true as soon as the site is served over HTTPS.
TUJYA_COOKIE_SECURE=false

# How long a sign-in lasts.
TUJYA_SESSION_HOURS=12

# Defaults: backend/app.db and ../data/parquet (the pipeline's processed tables)
# TUJYA_DATABASE_URL=sqlite:///C:/path/to/app.db
# TUJYA_PROCESSED_DIR=C:/path/to/data/parquet
